   "source": [
    " Remove Outermost Parentheses"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "273ffad9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "()()()\n"
     ]
    }
   ],
   "source": [
    "\n",
    "a = '(()())(())'\n",
    "result = ''\n",
    "count = 0\n",
    "for i in a:\n",
    "\tif i =='(':\n",
    "\t\tcount+=1\n",
    "\t\tif count >1:\n",
    "\t\t\tresult = result+i\n",
    "\telse:\n",
    "\t\tcount -=1\n",
    "\t\tif count !=0:\n",
    "\t\t\tresult = result+i\n",
    "print(result)"
   ]
  },
